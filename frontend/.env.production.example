# Copy to frontend/.env.production on the VPS and fill in real values.
# Never commit the real file — .gitignore already excludes .env.production.

NEXTAUTH_URL=https://your-domain.com
AUTH_SECRET=replace-with-32-char-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# Docker Compose service name, not localhost — server-only (never sent to the
# browser, see src/lib/api.ts), so the backend never needs a public port.
API_BASE_URL=http://backend-web:8000
# Must match ADMIN_API_KEY in backend/.env.production
ADMIN_API_KEY=replace-with-same-key-as-backend
