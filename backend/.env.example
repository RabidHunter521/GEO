# PRODUCTION uses the Railway `Postgres` service, reachable only from inside
# the Railway project's private network:
#   postgresql://postgres:[password]@postgres.railway.internal:5432/railway
# Production does NOT use Supabase. A stale Supabase project still exists with
# a divergent copy of the data — pointing this file at it makes local runs look
# like production while reading the wrong database. See CLAUDE.md §8.
# For local development, use a local Postgres:
DATABASE_URL=postgresql://postgres:[password]@localhost:5432/seenby
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RESEND_API_KEY=your_resend_api_key_here
# Optional: Telegram admin alerts. Leave blank to disable (alerts still email).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_API_KEY=change_me_to_a_random_secret
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
CLOUDFLARE_R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Private bucket — report PDFs. Keep public access DISABLED; reports are served
# only via short-lived presigned URLs.
CLOUDFLARE_R2_BUCKET_NAME=seenby-reports
# Public bucket — client logos only. Must allow public read (logos are embedded
# in emails / the public client view and can't expire). Keep this separate from
# the report bucket so report PDFs are never publicly fetchable.
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=seenby-public
# Public base URL (custom domain or r2.dev) bound to the PUBLIC bucket above.
CLOUDFLARE_R2_PUBLIC_URL=https://pub.r2.dev/<public_bucket_name>
